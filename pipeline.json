{
  "pipeline": [
    {
      "$match": {
        "$and": [
          {
            "is_deleted": {
              "$eq": "?bool"
            }
          },
          {
            "is_email_verified": {
              "$eq": "?bool"
            }
          },
          {
            "role": {
              "$eq": "?string"
            }
          },
          {
            "email_id": {
              "$in": "?array<?string>"
            }
          },
          {
            "_id": {
              "$not": {
                "$eq": "?objectId"
              }
            }
          }
        ]
      }
    },
    {
      "$lookup": {
        "from": "profile_management",
        "as": "profile_details",
        "let": {
          "userId": "$_id"
        },
        "pipeline": [
          {
            "$match": {
              "$expr": {
                "$eq": ["$user_id", "$$userId"]
              }
            }
          },
          {
            "$limit": "?number"
          }
        ]
      }
    },
    {
      "$lookup": {
        "from": "user_settings",
        "as": "user_settings",
        "let": {
          "userId": "$_id"
        },
        "pipeline": [
          {
            "$match": {
              "$expr": {
                "$eq": ["$user_id", "$$userId"]
              }
            }
          },
          {
            "$limit": "?number"
          }
        ]
      }
    },
    {
      "$unwind": {
        "path": "$profile_details",
        "preserveNullAndEmptyArrays": "?bool"
      }
    },
    {
      "$unwind": {
        "path": "$user_settings",
        "preserveNullAndEmptyArrays": "?bool"
      }
    },
    {
      "$lookup": {
        "from": "connection_request_management",
        "as": "connection_info",
        "let": {
          "userId": "$_id",
          "currentUserId": "?objectId"
        },
        "pipeline": [
          {
            "$match": {
              "$expr": {
                "$and": [
                  {
                    "$or": [
                      {
                        "$eq": ["$request_from", "$$currentUserId"]
                      },
                      {
                        "$eq": ["$request_to", "$$currentUserId"]
                      }
                    ]
                  },
                  {
                    "$or": [
                      {
                        "$eq": ["$request_from", "$$userId"]
                      },
                      {
                        "$eq": ["$request_to", "$$userId"]
                      }
                    ]
                  },
                  {
                    "$ne": ["$status", "?string"]
                  },
                  {
                    "$eq": ["$is_deleted", "?bool"]
                  }
                ]
              }
            }
          },
          {
            "$sort": {
              "_id": -1
            }
          },
          {
            "$limit": "?number"
          }
        ]
      }
    },
    {
      "$lookup": {
        "from": "attendee-passes",
        "as": "attendee_passes_details",
        "let": {
          "userId": "$email_id"
        },
        "pipeline": [
          {
            "$match": {
              "$expr": {
                "$eq": ["$email", "$$userId"]
              }
            }
          },
          {
            "$limit": "?number"
          }
        ]
      }
    },
    {
      "$unwind": {
        "path": "$attendee_passes_details",
        "preserveNullAndEmptyArrays": "?bool"
      }
    },
    {
      "$unwind": {
        "path": "$connection_info",
        "preserveNullAndEmptyArrays": "?bool"
      }
    },
    {
      "$lookup": {
        "from": "ai_score",
        "as": "ai_score_details",
        "let": {
          "user_id": "?objectId",
          "user_id_2": "$_id"
        },
        "pipeline": [
          {
            "$match": {
              "$expr": {
                "$and": [
                  {
                    "$eq": ["$reference_id", "$$user_id_2"]
                  },
                  {
                    "$eq": ["$user_id", "$$user_id"]
                  },
                  {
                    "$eq": ["$reference_type", "?string"]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    {
      "$unwind": {
